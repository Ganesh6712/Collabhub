# ============================================================
# CollabHub — Environment Variables Example
# Copy this file to .env and fill in the secrets.
# ============================================================

# -------------------- Backend --------------------
PORT=4000
DATABASE_URL=postgresql://collabhub:collabhub_secret@localhost:5432/collabhub?schema=public
REDIS_URL=redis://localhost:6379

# Generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# SMTP (optional — defaults to Ethereal Email for testing)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=CollabHub <noreply@collabhub.com>

# -------------------- Frontend --------------------
NEXTAUTH_URL=http://localhost:3000

# Generate another strong random string
NEXTAUTH_SECRET=change_me_to_a_long_random_string

NEXT_PUBLIC_API_URL=http://localhost:4000